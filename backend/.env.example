# PostgreSQL local de développement (voir docker-compose.yml)
DATABASE_URL="postgresql://najah:najah_dev@localhost:5433/najah_partners?schema=public"

# ─────────────────────────── Auth (Tranche 2, D-016) ───────────────────────────
# Secrets JWT — générer des valeurs aléatoires longues en prod (ex. openssl rand -hex 32).
# NE JAMAIS committer de secrets réels : ces valeurs sont des placeholders.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Seconde authentification (D-051/D-058) : signe les jetons `X-Step-Up` et les défis de
# question secrète. DISTINCT du secret d'accès — avec un secret partagé, un jeton de seconde
# auth (qui porte lui aussi un `sub`) serait accepté comme jeton de session. Facultatif :
# à défaut, il est dérivé du secret d'accès, pour qu'un déploiement existant ne tombe pas
# parce qu'une variable a été ajoutée.
JWT_STEP_UP_SECRET="change-me-step-up-secret"

# Durées (formats: 15m, 1h, 7d)
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PASSWORD_RESET_TTL="1h"

# Coût bcrypt
BCRYPT_ROUNDS="10"

# Cookie du refresh token (httpOnly)
#  - COOKIE_SECURE=true en prod (HTTPS obligatoire).
#  - Cross-site API↔fronts (origines différentes) : COOKIE_SAMESITE=none + COOKIE_SECURE=true (HTTPS).
#  - En dev http même origine/proxy : lax suffit.
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"

# CORS : origines des fronts autorisées (séparées par des virgules), credentials activés.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3001"

# Environnement (production désactive le log du token de reset)
NODE_ENV="development"

# Pièces d'identité (D-018) — stockage LOCAL hors du dépôt git
IDENTITY_UPLOAD_DIR="../../najah-uploads"
