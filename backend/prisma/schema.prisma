// Najah Partners — schéma de données (Prisma 6 / PostgreSQL)
// Convention : code & nommage en anglais. Voir ../CLAUDE.md et ../../docs/spec.md §8.
// Unités : BV = Int partout ; DT = Decimal(12,3) (millimes tunisiens), affichage uniquement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum MemberStatus {
  REGISTERED // INSCRIT
  ACTIVE // ACTIF
  INACTIVE // INACTIF
}

enum Leg {
  LEFT
  RIGHT
}

enum EcardStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

// Origine d'une e-card (D-025). Elle décide du remboursement : une e-card MEMBER a débité
// le solde de son créateur, donc EXPIRED/REVOKED le lui recrédite ; une e-card GENESIS est
// née ex nihilo (aucun débit), il n'y a personne à rembourser — sa valeur disparaît.
enum EcardOrigin {
  MEMBER
  GENESIS
}

enum CommissionType {
  DIRECT
  INDIRECT
  STARTUP_BONUS
}

// D-025 : PAS de valeur `ECARD_USE`. L'e-card est un instrument de PAIEMENT consommé au point
// de transaction, jamais une recharge de solde : l'utiliser ne crédite RIEN au bénéficiaire.
// La valeur sort du solde à la création (ECARD_CREATION) et quitte le système à la
// consommation (l'e-card est brûlée). Réintroduire ECARD_USE ramènerait le modèle recharge.
enum BvMovementType {
  ECARD_CREATION // débit du créateur
  ECARD_REFUND // recrédit créateur (EXPIRED / REVOKED)
  COMMISSION // crédit issu d'un run
  ACTIVATION // consommation à l'activation
  ADMIN_ADJUSTMENT // motif obligatoire
  ADMIN_GENESIS // amorçage réseau / promo
}

enum ProductType {
  PHYSICAL
  VIRTUAL
}

enum RunStatus {
  IN_PROGRESS
  SUCCESS
  ERROR
}

enum OrderContext {
  ACTIVATION
  FREE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum ShipmentStatus {
  PREPARATION
  SHIPPED
  DELIVERED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  SUPPORT
}

// Type d'acteur porté par le JWT (cloisonnement MEMBER / ADMIN, D-016)
enum ActorType {
  MEMBER
  ADMIN
}

// Vérification d'identité légère et NON bloquante (D-018) : elle informe l'admin,
// elle n'empêche jamais un membre de s'inscrire, de s'activer ni de percevoir.
enum IdDocumentType {
  ID_CARD // CIN
  DRIVING_LICENSE
  PASSPORT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─────────────────────────── Member (nœud d'arbre 1:1) ───────────────────────────

model Member {
  id           Int          @id @default(autoincrement())
  memberCode   String       @unique // NP + auto-incrément
  lastName     String
  firstName    String
  email        String?      @unique
  phone        String?      @unique
  passwordHash String
  status       MemberStatus @default(REGISTERED)

  // Pack (choisi à l'activation)
  packId Int?
  pack   Pack? @relation(fields: [packId], references: [id])

  // Snapshot du pack FIGÉ à l'activation (spec §5.8 : « chaque commission ET activation fige
  // les paramètres applicables »). Le moteur de commissions lit CES valeurs, jamais Pack en
  // direct : modifier un palier ne doit jamais réécrire l'historique. `packId` reste la FK
  // d'affichage. activationTierBv est sorti du Json car le calcul des cycles s'en sert.
  activationTierBv   Int?
  activationSnapshot Json? // { packName, tierBv, directCommissionBv, indirectCommissionBv, weeklyCapBv }

  // Deux liens distincts (self-relations). onDelete: Restrict — le défaut Prisma
  // (SET NULL) réenracinerait le sous-arbre d'un membre supprimé : placement immuable.
  sponsorId Int?
  sponsor   Member?  @relation("Sponsorship", fields: [sponsorId], references: [id], onDelete: Restrict)
  referrals Member[] @relation("Sponsorship")

  uplineId  Int?
  upline    Member?  @relation("Placement", fields: [uplineId], references: [id], onDelete: Restrict)
  downlines Member[] @relation("Placement")
  leg       Leg? // position sous l'upline

  // Solde & dates
  bvBalance    Int       @default(0)
  registeredAt DateTime  @default(now())
  activatedAt  DateTime?
  renewalAt    DateTime?

  // Baseline figée à l'activation (points antérieurs exclus du calcul propre)
  baselineLeft  Int @default(0)
  baselineRight Int @default(0)

  // Accumulateurs binaires (repris de NoeudArbre §8, fusionnés ici — relation 1:1)
  leftPoints         Int @default(0) // semaine en cours
  rightPoints        Int @default(0)
  carriedLeftPoints  Int @default(0) // report / carry-over
  carriedRightPoints Int @default(0)

  // Réserve de bonus de démarrage (défaut 6, initialisée à l'activation)
  startupBonusRemaining Int @default(0)

  // Vérification d'identité (D-018) — jamais bloquante. Le fichier est stocké hors du
  // dépôt (IDENTITY_UPLOAD_DIR) ; seul son chemin RELATIF est en base. Le badge admin
  // (VERIFIED / REJECTED) est apposé en Tranche 8.
  idDocumentType     IdDocumentType?
  idDocumentPath     String?
  verificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations inverses
  createdEcards  Ecard[]         @relation("EcardCreator")
  receivedEcards Ecard[]         @relation("EcardUser")
  ledgerEntries  BvLedgerEntry[]
  commissions    Commission[]
  orders         Order[]

  // Auth (Tranche 2)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([uplineId, leg]) // 1 enfant gauche + 1 droit max → placement immuable, pas de spillover
  @@index([uplineId])
  @@index([sponsorId])
  @@index([leg])
  @@index([status])
  @@index([verificationStatus]) // file de vérification admin (Tranche 8)
}

// ─────────────────────────── Pack (palier) ───────────────────────────

model Pack {
  id                   Int     @id @default(autoincrement())
  name                 String  @unique
  tierBv               Int
  refPriceDt           Decimal @db.Decimal(12, 3)
  directCommissionBv   Int
  indirectCommissionBv Int
  weeklyCapBv          Int
  active               Boolean @default(true)

  members Member[]
}

// ─────────────────────────── Grand livre BV ───────────────────────────

model BvLedgerEntry {
  id           Int            @id @default(autoincrement())
  memberId     Int
  member       Member         @relation(fields: [memberId], references: [id])
  type         BvMovementType
  amountBv     Int // signé : + crédit / − débit
  balanceAfter Int
  // Références nullables selon la source du mouvement
  ecardId      Int?
  ecard        Ecard?         @relation(fields: [ecardId], references: [id])
  commissionId Int?
  commission   Commission?    @relation(fields: [commissionId], references: [id])
  reason       String? // obligatoire pour ADMIN_ADJUSTMENT (contrôlé en code)
  createdAt    DateTime       @default(now())

  @@index([memberId])
  @@index([memberId, createdAt])
}

// ─────────────────────────── E-card ───────────────────────────

model Ecard {
  id      Int         @id @default(autoincrement())
  code    String      @unique // XXX-XXX-XXX-XXX
  valueBv Int
  status  EcardStatus @default(ACTIVE)
  origin  EcardOrigin @default(MEMBER)

  // creatorId est nul SI ET SEULEMENT SI origin = GENESIS (contrainte CHECK en base) :
  // une e-card de genèse n'a débité personne, donc personne à rembourser à son expiration.
  // onDelete: Restrict — le défaut Prisma (SET NULL) ferait passer l'e-card d'un membre
  // supprimé pour une e-card de GENÈSE (creatorId nul), donc non remboursable : la
  // suppression d'un membre falsifierait la comptabilité BV. Interdit.
  creatorId Int?
  creator   Member? @relation("EcardCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  // Admin auteur de la genèse (SUPER_ADMIN, D-017b) — qui a créé de la valeur ex nihilo.
  createdByAdminId Int?
  createdByAdmin   AdminUser? @relation("EcardGenesisAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  userId Int?
  user   Member? @relation("EcardUser", fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime? // null = illimité (paramètre ecard_expiration_days = -1)
  closedAt  DateTime? // horodatage du passage EXPIRED / REVOKED

  // Une e-card règle AU PLUS une commande (D-007 : une seule e-card par transaction, usage
  // unique). L'unicité est tenue en base par `Order.ecardId @unique` — d'où `Order?` et non
  // `Order[]` : deux commandes ne peuvent pas se réclamer de la même carte.
  order         Order?
  ledgerEntries BvLedgerEntry[]

  @@index([creatorId])
  @@index([userId])
  @@index([status])
  @@index([status, expiresAt]) // balayage du cron quotidien d'expiration
}

// ─────────────────────────── Commissions ───────────────────────────

model Commission {
  id             Int            @id @default(autoincrement())
  memberId       Int
  member         Member         @relation(fields: [memberId], references: [id])
  runId          Int
  run            CommissionRun  @relation(fields: [runId], references: [id])
  type           CommissionType
  amountBv       Int
  appliedCapBv   Int? // plafond figé si écrêtage
  cycles         Int            @default(0)
  snapshotParams Json // palier / commissions / plafond figés
  createdAt      DateTime       @default(now())

  ledgerEntries BvLedgerEntry[]

  @@index([memberId, runId])
  @@index([runId])
}

model CommissionRun {
  id            Int       @id @default(autoincrement())
  executedAt    DateTime  @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  memberCount   Int       @default(0)
  distributedBv Int       @default(0)
  status        RunStatus @default(IN_PROGRESS)
  log           String?   @db.Text

  commissions Commission[]
}

// ─────────────────────────── Boutique ───────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?     @db.Text
  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id])
  priceDt       Decimal     @db.Decimal(12, 3)
  valueBv       Int
  type          ProductType
  stock         Int? // null pour VIRTUAL
  shippingFeeDt Decimal     @default(0) @db.Decimal(12, 3)
  promoPriceDt  Decimal?    @db.Decimal(12, 3)
  images        String[]
  active        Boolean     @default(true)
  visibleOnSite Boolean     @default(true)

  lines OrderLine[]

  @@index([categoryId])
  @@index([active, visibleOnSite]) // liste boutique / vitrine
}

// Le checkout est atomique : une commande naît déjà PAID (e-card brûlée dans la même
// transaction). PENDING ne décrit donc aucun état réel du parcours — une commande qui
// n'aboutit pas est annulée par le rollback, elle n'existe jamais.
model Order {
  id       Int          @id @default(autoincrement())
  memberId Int
  member   Member       @relation(fields: [memberId], references: [id])
  context  OrderContext
  totalBv  Int
  // @unique : une e-card règle au plus une commande (D-007). Nullable pour ne pas fermer la
  // porte à une commande non réglée par e-card, mais le CHECK `Order_paid_ecard_ck` interdit
  // qu'une commande PAID soit sans e-card : aucun achat ne peut échapper au paiement.
  ecardId         Int?            @unique
  ecard           Ecard?          @relation(fields: [ecardId], references: [id])
  status          OrderStatus     @default(PENDING)
  shippingAddress String?
  shipmentStatus  ShipmentStatus? // null si la commande ne contient aucun produit PHYSICAL
  createdAt       DateTime        @default(now())
  paidAt          DateTime?

  lines OrderLine[]

  @@index([memberId])
  @@index([context])
  @@index([shipmentStatus]) // file de préparation admin
}

model OrderLine {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  unitValueBv Int // snapshot BV — figé au checkout, jamais relu depuis Product
  unitPriceDt Decimal @db.Decimal(12, 3) // snapshot du prix EFFECTIF affiché (promo appliquée). Affichage seul (D-002).

  // Un produit = une ligne : le checkout fusionne les quantités d'un même produit. Deux
  // lignes pour un même produit feraient diverger le contrôle de stock du total BV.
  @@unique([orderId, productId])
  @@index([orderId])
}

// ─────────────────────────── Admin, paramètres, audit ───────────────────────────

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MANAGER)
  permissions  Json? // permissions par module
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // Auth (Tranche 2)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // E-cards de genèse générées par cet admin (Tranche 5)
  genesisEcards Ecard[] @relation("EcardGenesisAdmin")
}

// ─────────────────────────── Auth : refresh tokens (D-016) ───────────────────────────
// Le refresh token n'est jamais stocké en clair : seule son empreinte SHA-256 est
// persistée. Rotation à chaque usage + détection de réutilisation par famille.

model RefreshToken {
  id          Int        @id @default(autoincrement())
  familyId    String // chaîne de rotation (une session = une famille)
  tokenHash   String     @unique // SHA-256 du token (jamais le clair)
  actorType   ActorType
  memberId    Int?
  member      Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  adminUserId Int?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime? // rotation, logout ou révocation de famille
  userAgent   String?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([familyId])
  @@index([memberId])
  @@index([adminUserId])
}

// ─────────────────────────── Auth : reset de mot de passe (D-011) ───────────────────────────
// Token à usage unique et expirant. Aucun envoi email/SMS (aucun fournisseur, D-011) :
// le canal de transmission reste à cadrer (notification in-app).

model PasswordResetToken {
  id          Int        @id @default(autoincrement())
  tokenHash   String     @unique // SHA-256, usage unique
  actorType   ActorType
  memberId    Int?
  member      Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  adminUserId Int?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime? // usage unique
  createdAt   DateTime   @default(now())

  @@index([memberId])
  @@index([adminUserId])
}

model Setting {
  key         String  @id
  value       String
  description String?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String // id admin ou "SYSTEM"
  action    String
  target    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
