// Najah Partners — schéma de données (Prisma 6 / PostgreSQL)
// Convention : code & nommage en anglais. Voir ../CLAUDE.md et ../../docs/spec.md §8.
//
// DEUX DIMENSIONS QUI NE SE CROISENT JAMAIS (D-028) — aucune conversion n'existe nulle part :
//   suffixe …Bv / …Points → POINTS, `Int` : composer le panier au palier d'un pack, alimenter
//                            les jambes de l'arbre. Un point ne vaut jamais de l'argent.
//   suffixe …Dt           → DINARS, `Decimal(12,3)` (millimes) : TOUT l'argent — solde d'un
//                            membre, valeur d'une e-card, grand livre, commissions, plafond
//                            hebdomadaire, prix. Le DT est transactionnel (D-002 révisée).
// « L'arbre compte des points, le portefeuille compte des dinars. »

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum MemberStatus {
  REGISTERED // INSCRIT
  ACTIVE // ACTIF
  INACTIVE // INACTIF
}

enum Leg {
  LEFT
  RIGHT
}

enum EcardStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

// Origine d'une e-card (D-025). Elle décide du remboursement : une e-card MEMBER a débité
// le solde de son créateur, donc EXPIRED/REVOKED le lui recrédite ; une e-card GENESIS est
// née ex nihilo (aucun débit), il n'y a personne à rembourser — sa valeur disparaît.
enum EcardOrigin {
  MEMBER
  GENESIS
}

// Événements de commission, écrits AU FIL DE L'EAU pendant la remontée d'arbre de
// l'activation (D-035). Le run hebdomadaire ne recalcule rien : il applique le plafond
// sur ces événements triés par date, puis crédite.
enum CommissionEventType {
  DIRECT // commission directe — pour le sponsor du filleul activé
  BALANCE // équilibre atteint — commission indirecte, un événement PAR cycle
  STARTUP_BONUS // D-031 : 2 membres activés dans le sous-arbre, une seule fois à vie
  REWARD_POINT // D-032 : chaque 6e équilibre à vie — 0 DT, +1 Point Fidélité
}

// Mouvements du grand livre — le journal des SOLDES, donc des DINARS (D-028).
//
// D-025 : PAS de valeur `ECARD_USE`. L'e-card est un instrument de PAIEMENT consommé au point
// de transaction, jamais une recharge de solde : l'utiliser ne crédite RIEN au bénéficiaire.
// La valeur sort du solde à la création (ECARD_CREATION) et quitte le système à la
// consommation (l'e-card est brûlée). Réintroduire ECARD_USE ramènerait le modèle recharge.
enum LedgerMovementType {
  ECARD_CREATION // débit du créateur
  ECARD_REFUND // recrédit créateur (EXPIRED / REVOKED)
  COMMISSION // crédit issu d'un run
  ACTIVATION // consommation à l'activation
  ADMIN_ADJUSTMENT // motif obligatoire
  ADMIN_GENESIS // amorçage réseau / promo
}

enum ProductType {
  PHYSICAL
  VIRTUAL
}

// Paiement d'ADHÉSION — l'argent qui achète le droit d'être membre, par opposition à la
// boutique (`Order`), qui achète des produits. Deux occasions, une seule mécanique : des
// e-cards brûlées pour un montant EXACT (D-036, D-038).
enum MembershipPaymentType {
  REGISTRATION // frais d'inscription (D-036) — ACOMPTE déduit du pack à l'activation (D-037)
  RENEWAL // renouvellement annuel (D-038)
}

// L'inscription est acquise dès qu'elle est payée (D-010 : aucune validation admin) ; le
// renouvellement, lui, ne vaut RIEN tant que l'admin ne l'a pas validé (D-038) — payer ne
// dégèle pas. D'où deux points d'entrée distincts dans cette machine à états.
enum MembershipPaymentStatus {
  SETTLED // inscription : réglée, acquise, définitive
  PENDING_VALIDATION // renouvellement : payé, en attente de l'admin
  VALIDATED // renouvellement : validé par l'admin (réactivation appliquée)
}

enum RunStatus {
  IN_PROGRESS
  SUCCESS
  ERROR
}

enum OrderContext {
  ACTIVATION
  FREE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum ShipmentStatus {
  PREPARATION
  SHIPPED
  DELIVERED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  SUPPORT
}

// Type d'acteur porté par le JWT (cloisonnement MEMBER / ADMIN, D-016)
enum ActorType {
  MEMBER
  ADMIN
}

// Vérification d'identité légère et NON bloquante (D-018) : elle informe l'admin,
// elle n'empêche jamais un membre de s'inscrire, de s'activer ni de percevoir.
enum IdDocumentType {
  ID_CARD // CIN
  DRIVING_LICENSE
  PASSPORT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─────────────────────────── Member (nœud d'arbre 1:1) ───────────────────────────

model Member {
  id           Int          @id @default(autoincrement())
  memberCode   String       @unique // NP + auto-incrément
  lastName     String
  firstName    String
  email        String?      @unique
  phone        String?      @unique
  passwordHash String
  status       MemberStatus @default(REGISTERED)

  // Pack (choisi à l'activation)
  packId Int?
  pack   Pack? @relation(fields: [packId], references: [id])

  // Snapshot du pack FIGÉ à l'activation (spec §5.8 : « chaque commission ET activation fige
  // les paramètres applicables »). Le moteur de commissions lit CES valeurs, jamais Pack en
  // direct : modifier un palier ne doit jamais réécrire l'historique. `packId` reste la FK
  // d'affichage. activationTierBv est sorti du Json car le calcul des cycles s'en sert.
  //
  // activationTierBv est en POINTS : c'est le palier injecté dans l'arbre. Le PRIX payé (DT)
  // vit dans le Json (`priceDt`) — les deux dimensions coexistent sans jamais se convertir.
  activationTierBv   Int? // POINTS
  activationSnapshot Json? // { packName, tierBv (pts), priceDt, directCommissionDt, indirectCommissionDt, weeklyCapDt }

  // Deux liens distincts (self-relations). onDelete: Restrict — le défaut Prisma
  // (SET NULL) réenracinerait le sous-arbre d'un membre supprimé : placement immuable.
  sponsorId Int?
  sponsor   Member?  @relation("Sponsorship", fields: [sponsorId], references: [id], onDelete: Restrict)
  referrals Member[] @relation("Sponsorship")

  uplineId  Int?
  upline    Member?  @relation("Placement", fields: [uplineId], references: [id], onDelete: Restrict)
  downlines Member[] @relation("Placement")
  leg       Leg? // position sous l'upline

  // Solde — DINARS (D-028). Le portefeuille du membre : commissions perçues, e-cards émises,
  // ajustements admin. Jamais des points : un point ne se dépense pas.
  balanceDt    Decimal   @default(0) @db.Decimal(12, 3)
  registeredAt DateTime  @default(now())
  activatedAt  DateTime?
  renewalAt    DateTime?

  // ── Ci-dessous : POINTS uniquement (l'arbre) ──
  // Baseline : cumul à vie des jambes figé à l'activation ET à chaque réactivation (D-034).
  // Depuis D-035 elle est purement documentaire (audit) : l'exclusion des points antérieurs
  // est portée par la POOL ci-dessous, qui ne reçoit rien tant que le membre n'est pas ACTIF.
  baselineLeft  Int @default(0)
  baselineRight Int @default(0)

  // Cumul À VIE des points reçus par jambe (audit / affichage) : crédité par CHAQUE
  // activation du sous-arbre, quel que soit l'état du membre (D-020). Jamais décrémenté.
  leftPoints  Int @default(0)
  rightPoints Int @default(0)

  // POOL APPARIABLE = carry-over courant (D-035) : points non encore consommés par un
  // équilibre. Créditée UNIQUEMENT quand le membre est ACTIF — c'est ce qui rend la baseline
  // (activation) et le gel (D-034 : les points du gel ne comptent jamais, le carry-over
  // d'avant gel est conservé) corrects par construction. Décrémentée à chaque équilibre.
  carriedLeftPoints  Int @default(0)
  carriedRightPoints Int @default(0)

  // ── Moteur de commissions (D-031, D-032) ──
  // Bonus de démarrage : UNE commission indirecte quand le sous-arbre atteint 2 membres
  // activés — une seule fois à vie (D-031, annule la réserve de 6 paliers de D-012).
  startupBonusUsed     Boolean @default(false)
  // Compteur d'équilibres À VIE, jamais remis à zéro (bonus inclus) : chaque multiple de 6
  // donne un Point Fidélité au lieu d'une commission (D-032).
  lifetimeBalanceCount Int     @default(0)
  // Points Fidélité — TROISIÈME unité, distincte des points BV et des dinars (D-032).
  // L'achat de produits avec ces points est hors scope (tranche ultérieure).
  rewardPoints         Int     @default(0)
  // Nombre de membres ACTIVÉS (activatedAt non nul) dans le sous-arbre : maintenu par la
  // propagation d'activation, sous le verrou de chaîne — rend le déclencheur du bonus
  // (« exactement 2 ») O(1) et sérialisé, sans CTE de comptage par ancêtre.
  activatedDescendants Int     @default(0)

  // Vérification d'identité (D-018) — jamais bloquante. Le fichier est stocké hors du
  // dépôt (IDENTITY_UPLOAD_DIR) ; seul son chemin RELATIF est en base. Le badge admin
  // (VERIFIED / REJECTED) est apposé en Tranche 8.
  idDocumentType     IdDocumentType?
  // Numéro de la pièce, SAISI À LA MAIN par le membre (D-039) : l'admin le compare à
  // l'image. Informatif comme le reste de la vérification — un membre PENDING s'inscrit,
  // s'active et perçoit normalement. Rien ici ne bloque quoi que ce soit.
  idDocumentNumber   String?
  idDocumentPath     String?
  verificationStatus VerificationStatus @default(PENDING)

  // QUI a statué, QUAND, et POURQUOI en cas de rejet (Tranche 8c — le module de vérification
  // était en attente depuis T4). Sans ces trois colonnes, le badge ne serait qu'un état sans
  // auteur : un membre REJECTED n'aurait aucun moyen de savoir ce qu'on lui reproche, et le
  // support devrait fouiller l'AuditLog pour le lui dire. Le motif est EXIGÉ pour un rejet,
  // interdit de sens pour une validation (rien à motiver).
  //
  // Rien ici ne bloque quoi que ce soit (D-018) : ces colonnes informent, elles n'autorisent ni
  // n'interdisent aucune opération — un membre PENDING ou REJECTED s'inscrit, s'active,
  // perçoit et renouvelle normalement.
  verificationReason    String?
  verificationAt        DateTime?
  verificationByAdminId Int?
  verificationByAdmin   AdminUser? @relation("MemberVerifier", fields: [verificationByAdminId], references: [id], onDelete: Restrict)

  // DINARS — frais d'inscription RÉELLEMENT réglés par e-card(s) (D-036), figés à
  // l'inscription. C'est l'ACOMPTE déduit du prix du pack à l'activation (D-037 :
  // Silver = 2200 − 100 = 2100 DT dus). Le calcul lit CETTE colonne, jamais le paramètre
  // `registration_fee_dt` courant : changer le tarif demain ne réécrit aucun acompte déjà
  // versé. Vaut 0 pour les membres antérieurs à la Tranche 7.5 (racine d'amorçage
  // comprise) — c'est la vérité historique : ils n'ont rien versé DANS le système.
  registrationPaidDt Decimal @default(0) @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations inverses
  createdEcards      Ecard[]             @relation("EcardCreator")
  receivedEcards     Ecard[]             @relation("EcardUser")
  ledgerEntries      LedgerEntry[]
  commissions        Commission[]
  commissionEvents   CommissionEvent[]   @relation("CommissionEventBeneficiary")
  sourcedEvents      CommissionEvent[]   @relation("CommissionEventSource")
  orders             Order[]
  membershipPayments MembershipPayment[]

  // Auth (Tranche 2)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([uplineId, leg]) // 1 enfant gauche + 1 droit max → placement immuable, pas de spillover
  @@index([uplineId])
  @@index([sponsorId])
  @@index([leg])
  @@index([status])
  @@index([verificationStatus]) // file de vérification admin (Tranche 8)
}

// ─────────────────────────── Pack (palier) ───────────────────────────

// Le pack porte les DEUX dimensions, sans passerelle entre elles (D-028) :
//   `tierBv`  — POINTS : ce que le panier doit totaliser (D-006) et ce que l'arbre reçoit (D-005) ;
//   `priceDt` — DINARS : ce que l'activation FAIT PAYER (D-029). Ce n'est pas la somme des prix
//               des produits du panier, et ce n'est la conversion de rien.
model Pack {
  id                   Int     @id @default(autoincrement())
  name                 String  @unique
  tierBv               Int // POINTS — palier
  priceDt              Decimal @db.Decimal(12, 3) // DINARS — prix payé à l'activation (D-029)
  directCommissionDt   Decimal @db.Decimal(12, 3) // DINARS
  indirectCommissionDt Decimal @db.Decimal(12, 3) // DINARS — par cycle
  weeklyCapDt          Decimal @db.Decimal(12, 3) // DINARS — plafond hebdomadaire
  active               Boolean @default(true)

  members Member[]
}

// ─────────────────────────── Paiement d'adhésion (DINARS) ───────────────────────────

// Ce qu'on paie pour ÊTRE membre — inscription (D-036) et renouvellement annuel (D-038) —
// par opposition à `Order`, qui achète des produits. Réglé exclusivement par e-card(s) :
// depuis la Tranche 7.5, plus AUCUN montant ne se règle « en espèces hors système » à
// l'entrée du réseau. Plusieurs e-cards sont cumulables, leur somme doit égaler EXACTEMENT
// `amountDt` (D-030).
//
// Ce modèle porte aussi la TRAÇABILITÉ des cartes brûlées : une e-card d'inscription n'a
// aucune commande pour témoigner de ce qu'elle a payé. Sans ce lien, une carte `USED`
// resterait un débit sans contrepartie lisible.
model MembershipPayment {
  id       Int                     @id @default(autoincrement())
  memberId Int
  member   Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  type     MembershipPaymentType
  status   MembershipPaymentStatus
  // DINARS — montant SNAPSHOTÉ au moment du paiement (spec §5.8) : modifier le paramètre
  // `registration_fee_dt` / `annual_renewal_dt` ne réécrit jamais un paiement passé.
  amountDt Decimal                 @db.Decimal(12, 3)
  paidAt   DateTime                @default(now())

  // Validation admin — renouvellement UNIQUEMENT (D-038). Une inscription naît SETTLED :
  // elle n'attend personne (D-010). CHECK en base : VALIDATED ⇔ on sait qui et quand.
  validatedAt        DateTime?
  validatedByAdminId Int?
  validatedByAdmin   AdminUser? @relation("MembershipPaymentValidator", fields: [validatedByAdminId], references: [id], onDelete: Restrict)

  // Les e-cards brûlées pour ce paiement (1..n, D-030).
  ecards Ecard[]

  @@index([memberId])
  @@index([status, type]) // file de validation admin (T8)
}

// ─────────────────────────── Grand livre (DINARS) ───────────────────────────
// Le grand livre est le journal des SOLDES, donc des DINARS (D-028). Aucun point n'y entre :
// les points de l'arbre ne sont pas un avoir, ils ne se dépensent pas et ne se créditent pas.

model LedgerEntry {
  id             Int                @id @default(autoincrement())
  memberId       Int
  member         Member             @relation(fields: [memberId], references: [id])
  type           LedgerMovementType
  amountDt       Decimal            @db.Decimal(12, 3) // signé : + crédit / − débit
  balanceAfterDt Decimal            @db.Decimal(12, 3)
  // Références nullables selon la source du mouvement
  ecardId        Int?
  ecard          Ecard?             @relation(fields: [ecardId], references: [id])
  commissionId   Int?
  commission     Commission?        @relation(fields: [commissionId], references: [id])
  reason         String? // obligatoire pour ADMIN_ADJUSTMENT (contrôlé en code)
  createdAt      DateTime           @default(now())

  @@index([memberId])
  @@index([memberId, createdAt])
}

// ─────────────────────────── E-card ───────────────────────────

model Ecard {
  id      Int         @id @default(autoincrement())
  code    String      @unique // XXX-XXX-XXX-XXX
  valueDt Decimal     @db.Decimal(12, 3) // DINARS — une e-card est de l'argent (D-028)
  status  EcardStatus @default(ACTIVE)
  origin  EcardOrigin @default(MEMBER)

  // creatorId est nul SI ET SEULEMENT SI origin = GENESIS (contrainte CHECK en base) :
  // une e-card de genèse n'a débité personne, donc personne à rembourser à son expiration.
  // onDelete: Restrict — le défaut Prisma (SET NULL) ferait passer l'e-card d'un membre
  // supprimé pour une e-card de GENÈSE (creatorId nul), donc non remboursable : la
  // suppression d'un membre falsifierait la comptabilité BV. Interdit.
  creatorId        Int?
  creator          Member?    @relation("EcardCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  // Admin auteur de la genèse (SUPER_ADMIN, D-017b) — qui a créé de la valeur ex nihilo.
  createdByAdminId Int?
  createdByAdmin   AdminUser? @relation("EcardGenesisAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  userId Int?
  user   Member? @relation("EcardUser", fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime? // null = illimité (paramètre ecard_expiration_days = -1)
  closedAt  DateTime? // horodatage du passage EXPIRED / REVOKED

  // CE QUE LA CARTE A PAYÉ — au plus UNE chose, jamais deux (usage unique, D-007). Depuis
  // D-030 (cumul), le lien est porté ICI et non plus par `Order.ecardId` : une commande se
  // règle avec 1..n cartes, une carte règle 0..1 commande. Le sens de la FK suit celui de
  // la cardinalité, et l'unicité « une carte ne paie qu'une commande » devient structurelle
  // — une colonne ne peut pas contenir deux valeurs.
  orderId             Int?
  order               Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  membershipPaymentId Int?
  membershipPayment   MembershipPayment? @relation(fields: [membershipPaymentId], references: [id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@index([creatorId])
  @@index([userId])
  @@index([status])
  @@index([status, expiresAt]) // balayage du cron quotidien d'expiration
  @@index([orderId])
  @@index([membershipPaymentId])
}

// ─────────────────────────── Commissions ───────────────────────────

// ÉVÉNEMENT de commission (D-035) : écrit au fil de l'eau, dans la transaction de
// l'activation qui l'a produit — jamais recalculé, jamais rejoué. Un événement est de
// l'ARGENT dû (DINARS, D-028), sauf REWARD_POINT (0 DT, un Point Fidélité — D-032).
// Deux CHECK en base gardent ces invariants :
//   `CommissionEvent_reward_zero_ck`   — REWARD_POINT ⇒ amountDt = 0 ;
//   `CommissionEvent_balance_index_ck` — balanceIndex IS NULL ⇔ type = DIRECT.
model CommissionEvent {
  id             Int                 @id @default(autoincrement())
  memberId       Int // bénéficiaire de la commission
  member         Member              @relation("CommissionEventBeneficiary", fields: [memberId], references: [id])
  type           CommissionEventType
  amountDt       Decimal             @db.Decimal(12, 3) // DINARS — 0 pour REWARD_POINT
  // Horodatage RÉEL (timestamp de la transaction d'activation) : c'est lui, puis l'id,
  // qui portent la chronologie du plafond (D-033 — DIRECT inséré avant BALANCE).
  occurredAt     DateTime            @default(now())
  sourceMemberId Int // le filleul dont l'activation a produit l'événement
  sourceMember   Member              @relation("CommissionEventSource", fields: [sourceMemberId], references: [id])
  // Éligibilité évaluée AU MOMENT de l'événement (D-034) : un bénéficiaire gelé ou encore
  // INSCRIT donne eligible=false — l'événement est tracé mais ne sera JAMAIS payé.
  eligible       Boolean
  // paid : l'événement a contribué (même partiellement) au versement d'un run. Un événement
  // réclamé (runId non nul) mais paid=false a été perdu : inéligible, ou au-delà du plafond.
  paid           Boolean             @default(false)
  runId          Int?
  run            CommissionRun?      @relation(fields: [runId], references: [id])
  snapshot       Json // paramètres figés au moment de l'événement (palier, montant, pack source…)
  // N° d'équilibre à vie concerné (D-032) — null pour DIRECT, 1 pour le bonus (D-031).
  balanceIndex   Int?

  @@index([memberId, occurredAt])
  @@index([runId])
  @@index([occurredAt]) // réclamation du run : runId IS NULL + borne de période
}

// RÈGLEMENT d'un membre pour un run (D-035) : l'agrégat plafonné des événements de la
// période. Le détail (chronologie, perdu/payé) vit dans CommissionEvent ; l'argent versé
// (DINARS, D-028) part au grand livre via la ligne liée.
model Commission {
  id                  Int           @id @default(autoincrement())
  memberId            Int
  member              Member        @relation(fields: [memberId], references: [id])
  runId               Int
  run                 CommissionRun @relation(fields: [runId], references: [id])
  grossDt             Decimal       @db.Decimal(12, 3) // DINARS — total éligible avant plafond
  paidDt              Decimal       @db.Decimal(12, 3) // DINARS — versé = min(gross, plafond) ; l'écart est PERDU (D-033)
  // Plafond appliqué, FIGÉ ici (snapshot) : celui du snapshot d'activation du membre — le
  // moteur ne lit jamais Pack en direct, un changement de pack ne touche que l'avenir.
  appliedCapDt        Decimal       @db.Decimal(12, 3)
  eventCount          Int
  rewardPointsGranted Int           @default(0) // D-032 — Points Fidélité accordés sous le plafond
  rewardPointsLost    Int           @default(0) // D-032 — survenus après le plafond : perdus
  snapshotParams      Json // palier (pts) / montants (DT) / plafond (DT) figés
  createdAt           DateTime      @default(now())

  ledgerEntries LedgerEntry[]

  @@unique([memberId, runId]) // un règlement par membre et par run (idempotence)
  @@index([runId])
}

model CommissionRun {
  id                  Int       @id @default(autoincrement())
  executedAt          DateTime  @default(now())
  periodStart         DateTime
  periodEnd           DateTime
  memberCount         Int       @default(0)
  distributedDt       Decimal   @default(0) @db.Decimal(12, 3) // DINARS versés sur le run
  rewardPointsGranted Int       @default(0) // Points Fidélité accordés sur le run (D-032)
  status              RunStatus @default(IN_PROGRESS)
  log                 String?   @db.Text

  commissions Commission[]
  events      CommissionEvent[]
}

// ─────────────────────────── Boutique ───────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  sortOrder   Int       @default(0)
  products    Product[]
}

// Le produit porte les deux dimensions, sans lien entre elles (D-028) : `valueBv` compose le
// palier d'un pack (POINTS), `priceDt` est ce qu'il coûte (DINARS). Deux produits de même
// valeur BV peuvent avoir des prix différents — et c'est normal, l'un n'est pas l'autre.
model Product {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?     @db.Text
  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id])
  priceDt       Decimal     @db.Decimal(12, 3) // DINARS — montant dû en achat LIBRE
  valueBv       Int // POINTS — compose le palier (activation)
  type          ProductType
  stock         Int? // null pour VIRTUAL
  shippingFeeDt Decimal     @default(0) @db.Decimal(12, 3) // DINARS — affiché, réglé HORS système
  promoPriceDt  Decimal?    @db.Decimal(12, 3) // DINARS — prix effectif s'il existe ; le BV ne bouge pas
  images        String[]
  active        Boolean     @default(true)
  visibleOnSite Boolean     @default(true)

  lines OrderLine[]

  @@index([categoryId])
  @@index([active, visibleOnSite]) // liste boutique / vitrine
}

// Le checkout est atomique : une commande naît déjà PAID (e-card brûlée dans la même
// transaction). PENDING ne décrit donc aucun état réel du parcours — une commande qui
// n'aboutit pas est annulée par le rollback, elle n'existe jamais.
//
// LES DEUX TOTAUX NE SE DÉDUISENT PAS L'UN DE L'AUTRE (D-028) :
//   `totalDt`     — DINARS payés (le montant que les e-cards ont couvert exactement) :
//                     ACTIVATION → PRIX DU PACK − ACOMPTE D'INSCRIPTION (D-029 + D-037), PAS la
//                                  somme des prix des produits du panier (un panier Silver à
//                                  380 DT de produits paie 2200 − 100 = 2100 DT) ;
//                     LIBRE      → Σ (prix effectif × quantité).
//   `totalPoints` — POINTS du panier, Σ (valeur BV × quantité) : en ACTIVATION, la preuve figée
//                   que le panier faisait EXACTEMENT le palier, et ce que l'arbre a reçu.
model Order {
  id              Int             @id @default(autoincrement())
  memberId        Int
  member          Member          @relation(fields: [memberId], references: [id])
  context         OrderContext
  totalDt         Decimal         @db.Decimal(12, 3) // DINARS — montant payé
  totalPoints     Int // POINTS — Σ des valeurs BV du panier
  // Les e-cards qui ont réglé cette commande : 1..n depuis D-030 (cumul). Le lien vit du
  // côté `Ecard` (`Ecard.orderId`) — c'est là qu'est la cardinalité 1.
  ecards          Ecard[]
  // Nombre de cartes brûlées, FIGÉ à la création. Dénormalisé pour une seule raison : garder
  // en base l'invariant de D-027 « aucune commande PAID sans e-card », qu'un CHECK ne peut
  // pas exprimer à travers une autre table. Écrit une fois, jamais mis à jour.
  ecardCount      Int             @default(0)
  status          OrderStatus     @default(PENDING)
  shippingAddress String?
  shipmentStatus  ShipmentStatus? // null si la commande ne contient aucun produit PHYSICAL
  createdAt       DateTime        @default(now())
  paidAt          DateTime?

  lines OrderLine[]

  @@index([memberId])
  @@index([context])
  @@index([shipmentStatus]) // file de préparation admin
}

model OrderLine {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  unitValueBv Int // POINTS — snapshot figé au checkout, jamais relu depuis Product
  // DINARS — snapshot du prix EFFECTIF (promo appliquée). TRANSACTIONNEL depuis D-028/D-002
  // révisée : en achat LIBRE, c'est lui qui compose le montant dû. Une revalorisation du
  // produit demain ne réécrit donc aucune commande passée.
  unitPriceDt Decimal @db.Decimal(12, 3)

  // Un produit = une ligne : le checkout fusionne les quantités d'un même produit. Deux
  // lignes pour un même produit feraient diverger le contrôle de stock du total BV.
  @@unique([orderId, productId])
  @@index([orderId])
}

// ─────────────────────────── Admin, paramètres, audit ───────────────────────────

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MANAGER)
  permissions  Json? // permissions par module
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // Auth (Tranche 2)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // E-cards de genèse générées par cet admin (Tranche 5)
  genesisEcards Ecard[] @relation("EcardGenesisAdmin")

  // Renouvellements annuels validés par cet admin (Tranche 7.5, D-038)
  validatedMembershipPayments MembershipPayment[] @relation("MembershipPaymentValidator")

  // Vérifications d'identité statuées par cet admin (Tranche 8c, D-018/D-039)
  verifiedMembers Member[] @relation("MemberVerifier")
}

// ─────────────────────────── Auth : refresh tokens (D-016) ───────────────────────────
// Le refresh token n'est jamais stocké en clair : seule son empreinte SHA-256 est
// persistée. Rotation à chaque usage + détection de réutilisation par famille.

model RefreshToken {
  id          Int        @id @default(autoincrement())
  familyId    String // chaîne de rotation (une session = une famille)
  tokenHash   String     @unique // SHA-256 du token (jamais le clair)
  actorType   ActorType
  memberId    Int?
  member      Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  adminUserId Int?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime? // rotation, logout ou révocation de famille
  userAgent   String?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([familyId])
  @@index([memberId])
  @@index([adminUserId])
}

// ─────────────────────────── Auth : reset de mot de passe (D-011) ───────────────────────────
// Token à usage unique et expirant. Aucun envoi email/SMS (aucun fournisseur, D-011) :
// le canal de transmission reste à cadrer (notification in-app).

model PasswordResetToken {
  id          Int        @id @default(autoincrement())
  tokenHash   String     @unique // SHA-256, usage unique
  actorType   ActorType
  memberId    Int?
  member      Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  adminUserId Int?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime? // usage unique
  createdAt   DateTime   @default(now())

  @@index([memberId])
  @@index([adminUserId])
}

model Setting {
  key         String  @id
  value       String
  description String?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String // id admin ou "SYSTEM"
  action    String
  target    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
